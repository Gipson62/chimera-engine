    #[c_name("glms_vec2_negate")]
    public extern fun vec2_negate(v: cglm::Vec2) -> cglm::Vec2;

    #[c_name("glms_vec2_normalize")]
    public extern fun vec2_normalize(v: cglm::Vec2) -> cglm::Vec2;

    #[c_name("glms_vec2_lerp")]
    public extern fun vec2_lerp(from: cglm::Vec2, to: cglm::Vec2, t: float32) -> cglm::Vec2;

    #[c_name("glms_vec2_distance")]
    public extern fun vec2_distance(a: cglm::Vec2, b: cglm::Vec2) -> float32;

