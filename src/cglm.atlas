// cglm Atlas77 binding
//
// This binding intentionally uses cglm's STRUCT API instead of the raw array
// API.  cglm's struct.h is a single umbrella header which includes cglm.h and
// the complete struct API, so the binding does not need to model every cglm
// header individually.
//
// The following Atlas types correspond to cglm's real C types:
//   cglm::Vec2  -> vec2s
//   cglm::Vec3  -> vec3s
//   cglm::Vec4  -> vec4s
//   cglm::IVec2 -> ivec2s
//   cglm::IVec3 -> ivec3s
//   cglm::IVec4 -> ivec4s
//   cglm::Mat2  -> mat2s
//   cglm::Mat3  -> mat3s
//   cglm::Mat4  -> mat4s
//   cglm::Quat  -> versors
//
// The raw members are included to make the representation explicit to
// Atlas77.  They are not aliases: cglm itself defines these as unions.
// For maximum portability, code should normally use the functions below
// rather than depending on cglm's optional anonymous x/y/z members.

namespace cglm {

    // ---------------------------------------------------------------------
    // Types
    // ---------------------------------------------------------------------

    #[c_name("vec2s")]
    public extern union Vec2 {
      public:
        raw: [float32; 2];
    }

    #[c_name("vec3s")]
    public extern union Vec3 {
      public:
        raw: [float32; 3];
    }

    #[c_name("vec4s")]
    public extern union Vec4 {
      public:
        raw: [float32; 4];
    }

    #[c_name("ivec2s")]
    public extern union IVec2 {
      public:
        raw: [int32; 2];
    }

    #[c_name("ivec3s")]
    public extern union IVec3 {
      public:
        raw: [int32; 3];
    }

    #[c_name("ivec4s")]
    public extern union IVec4 {
      public:
        raw: [int32; 4];
    }

    #[c_name("mat2s")]
    public extern union Mat2 {
      public:
        raw: [float32; 4];
    }

    #[c_name("mat3s")]
    public extern union Mat3 {
      public:
        raw: [float32; 9];
    }

    #[c_name("mat4s")]
    public extern union Mat4 {
      public:
        raw: [float32; 16];
    }

    // cglm calls its struct-API quaternion type `versors`.
    // Quaternions are stored as [x, y, z, w].
    #[c_name("versors")]
    public extern union Quat {
      public:
        raw: [float32; 4];
    }

    // ---------------------------------------------------------------------
    // Small constructors / helpers
    // ---------------------------------------------------------------------

    // These are Atlas-side constructors.  They do not call C and therefore
    // do not depend on cglm providing a constructor function.
    public fun vec2(x: float32, y: float32) -> cglm::Vec2 {
        return cglm::Vec2 { .raw = [x, y] };
    }

    public fun vec3(x: float32, y: float32, z: float32) -> cglm::Vec3 {
        return cglm::Vec3 { .raw = [x, y, z] };
    }

    public fun vec4(x: float32, y: float32, z: float32, w: float32) -> cglm::Vec4 {
        return cglm::Vec4 { .raw = [x, y, z, w] };
    }

    public fun ivec2(x: int32, y: int32) -> cglm::IVec2 {
        return cglm::IVec2 { .raw = [x, y] };
    }

    public fun ivec3(x: int32, y: int32, z: int32) -> cglm::IVec3 {
        return cglm::IVec3 { .raw = [x, y, z] };
    }

    public fun ivec4(x: int32, y: int32, z: int32, w: int32) -> cglm::IVec4 {
        return cglm::IVec4 { .raw = [x, y, z, w] };
    }

