import "std/optional";

import "src/glad.atlas";

import "src/stb_image.atlas";

public struct Texture2D {
  public:
    fun new(path: str) -> std::optional<This> {
        let width: int32 = 0;
        let height: int32 = 0;
        let nr_channels: int32 = 0;
        let data = stbi::load(path, &width, &height, &nr_channels, 0);

        if data == null {
            return std::optional<This>::empty();
        }
        
        let internal_format: int32 = GL::RGB;
        let data_format: uint32 = GL::RGB;

        if nr_channels == 4 {
            internal_format = GL::RGBA;
            data_format = GL::RGBA;
        }

        let texture = Texture2D {
            .id = 0,
        };
        glGenTextures(1, &texture.id);

        texture.bind();

        glTexParameteri(GL::TEXTURE_2D, GL::TEXTURE_WRAP_S, GL::REPEAT);	
        glTexParameteri(GL::TEXTURE_2D, GL::TEXTURE_WRAP_T, GL::REPEAT);
        glTexParameteri(GL::TEXTURE_2D, GL::TEXTURE_MIN_FILTER, GL::LINEAR_MIPMAP_LINEAR);
        glTexParameteri(GL::TEXTURE_2D, GL::TEXTURE_MAG_FILTER, GL::LINEAR);

        glTexImage2D(
            GL::TEXTURE_2D, 
            0, 
            internal_format, 
            width, 
            height, 
            0, 
            data_format, 
            GL::UNSIGNED_BYTE, 
            data as *unit
        );
        glGenerateMipmap(GL::TEXTURE_2D);
        stbi::image_free(data as *unit);

        return std::optional<This>::of(texture);
    }
    fun bind(*const this) {
        glBindTexture(GL::TEXTURE_2D, this->id);
    }
    // 
    fun set_texture_unit(*this, texture_unit: uint32) {
        glActiveTexture(texture_unit);
        this->bind();
    }

  private:
    id: uint32;
}