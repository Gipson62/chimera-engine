import "std/optional";

import "src/glad.atlas";

import "src/stb_image.atlas";

public struct Texture2D {
  public:
    fun new(path: str) -> std::optional<This> {
        let width: int32 = 0;
        let height: int32 = 0;
        let nr_channels: int32 = 0;
        let data = stbi::load(path, &width, &height, &nr_channels, 0);

        if data == null {
            return std::optional<This>::empty();
        }
        
        let internal_format: int32 = _GL_RGB() as int32;
        let data_format: uint32 = _GL_RGB();

        if nr_channels == 4 {
            internal_format = _GL_RGBA() as int32;
            data_format = _GL_RGBA();
        }

        let texture = Texture2D {
            .id = 0,
        };
        glGenTextures(1, &texture.id);

        texture.bind();

        glTexParameteri(_GL_TEXTURE_2D(), _GL_TEXTURE_WRAP_S(), _GL_REPEAT());	
        glTexParameteri(_GL_TEXTURE_2D(), _GL_TEXTURE_WRAP_T(), _GL_REPEAT());
        glTexParameteri(_GL_TEXTURE_2D(), _GL_TEXTURE_MIN_FILTER(), _GL_LINEAR_MIPMAP_LINEAR());
        glTexParameteri(_GL_TEXTURE_2D(), _GL_TEXTURE_MAG_FILTER(), _GL_LINEAR());

        glTexImage2D(
            _GL_TEXTURE_2D(), 
            0, 
            internal_format, 
            width, 
            height, 
            0, 
            data_format, 
            _GL_UNSIGNED_BYTE(), 
            data as *unit
        );
        glGenerateMipmap(_GL_TEXTURE_2D());
        stbi::image_free(data as *unit);

        return std::optional<This>::of(texture);
    }
    fun bind(*const this) {
        glBindTexture(_GL_TEXTURE_2D(), this->id);
    }
    // 
    fun set_texture_unit(*this, texture_unit: uint32) {
        glActiveTexture(texture_unit);
        this->bind();
    }

  private:
    id: uint32;
}