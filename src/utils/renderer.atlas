import "src/utils/model.atlas";

public struct Renderer {
  public:
    fun default() -> This { return Renderer {}; }

    fun clear_color(*const this, r: float32, g: float32, b: float32, a: float32) { glClearColor(r, g, b, a); }
    fun clear(*const this) { glClear(GL::COLOR_BUFFER_BIT | GL::DEPTH_BUFFER_BIT); }

    fun begin_scene(*const this, shader: *const ShaderProgram, view: *const la::mat4, projection: *const la::mat4) {
        shader->bind();
        shader->set_mat4("view", view);
        shader->set_mat4("projection", projection);
    }

    fun submit(
        *const this,
        va: *const VertexArray,
        ib: *const IndexBuffer,
        shader: *const ShaderProgram,
        model: *const la::mat4
    ) {
        shader->set_mat4("model", model);
        va->bind();
        ib->bind();
        glDrawElements(GL::TRIANGLES, ib->get_count(), GL::UNSIGNED_INT, null);
    }

    // Non-indexed single-mesh draw. Requires begin_scene() called first
    // (shader bound, view/projection set).
    fun submit_mesh(
        *const this,
        va: *const VertexArray,
        shader: *const ShaderProgram,
        model: *const la::mat4,
        vertex_count: int32
    ) {
        shader->set_mat4("model", model);
        va->bind();
        glDrawArrays(GL::TRIANGLES, 0, vertex_count);
    }

    // Non-indexed single-mesh draw. Requires begin_scene() called first
    // (shader bound, view/projection set).
    fun draw_model(
        *const this,
        model: *const Model,
        shader: *const ShaderProgram,
        view: *const la::mat4,
        projection: *const la::mat4
    ) {
        shader->bind();
        shader->set_mat4("view", view);
        shader->set_mat4("projection", projection);
        shader->set_mat4("model", &model->matrix);

        let i: uint64 = 0;
        while i < model->meshes.len() {
            let mesh = model->meshes.get(i);
            mesh->vertex_array()->bind();
            mesh->index_buffer()->bind();

            let j: uint64 = 0;
            while j < mesh->material.textures.len() {
                let tex = mesh->material.textures.get(j);
                
                tex->set_texture_unit(GL::TEXTURE0 as uint32 + j as uint32);
                
                shader->set_int(tex->type, j as int32);
                
                j = j + 1;
            }

            glActiveTexture(GL::TEXTURE0);

            shader->set_float("material.shininess", mesh->material.shininess);
            glDrawElements(GL::TRIANGLES, mesh->index_buffer()->get_count(), GL::UNSIGNED_INT, null);
            i = i + 1;
        }
    }

    fun draw(
        *const this,
        va: *const VertexArray,
        shader: *const ShaderProgram,
        positions: *const std::vector<la::vec3>,
        view: *const la::mat4,
        projection: *const la::mat4,
    ) {
        shader->bind();
        va->bind();

        let i: uint64 = 0;
        while i < positions->len() {
            let pos = positions->get(i);
            let angle = 20.0 * i as float32;
            let model_matrix = la::mat4::identity()
                .translated(pos->x(), pos->y(), pos->z())
                .rotated(&la::vec3::new(0.0, 0.0, -3.0), la::radians(angle));

            shader->set_mat4("model", &model_matrix);
            shader->set_mat4("view", view);
            shader->set_mat4("projection", projection);

            glDrawArrays(GL::TRIANGLES, 0, 36);
            i = i + 1;
        }
    }
}