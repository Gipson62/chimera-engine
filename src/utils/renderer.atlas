import "src/utils/model.atlas";
import "src/utils/light/directional_light.atlas";
import "src/utils/light/point_light.atlas";

public struct Renderer {
  public:
    default_diffuse: Texture2D;
    default_specular: Texture2D;
    default_normal_map: Texture2D;
    default_emission: Texture2D;
    fun default() -> This { 
        return Renderer {
            .default_diffuse    = Texture2D::from_color(
                255, 255, 255, 255, std::string::from_chars("material.diffuse")),
            .default_specular   = Texture2D::from_color(
                  0,   0,   0, 255, std::string::from_chars("material.specular")),
            .default_normal_map = Texture2D::from_color(
                128, 128, 255, 255, std::string::from_chars("material.normal_map")),
            .default_emission = Texture2D::from_color(
                  0,   0,   0, 255, std::string::from_chars("material.emission"))
        }; 
    }

    fun clear_color(*const this, r: float32, g: float32, b: float32, a: float32) { glClearColor(r, g, b, a); }
    fun clear(*const this) { glClear(GL::COLOR_BUFFER_BIT | GL::DEPTH_BUFFER_BIT); }

    fun draw_model(
        *const this,
        model: *const Model,
        shader: *const ShaderProgram,
        view: *const la::mat4,
        projection: *const la::mat4
        // Not necessary
        dir_light: *const DirectionalLight,
        point_lights: [*PointLight; 4],
        spot_lights: [*SpotLight; 2]
    ) {
        shader->bind();
        shader->set_mat4("view", view);
        shader->set_mat4("projection", projection);
        if dir_light != null {
            shader->set_vec3("dirLight.direction", &dir_light->direction);
            shader->set_vec3("dirLight.ambient", &dir_light->ambient);
            shader->set_vec3("dirLight.diffuse", &dir_light->diffuse);
            shader->set_vec3("dirLight.specular", &dir_light->specular);
        }

        let num_active_point_lights: int32 = 0;

        // TODO: Refactor this to be clean. It's ugly asf
        if point_lights[0] != null {
            num_active_point_lights = num_active_point_lights + 1;
            shader->set_vec3("pointLights[0].position", &point_lights[0]->position);
            shader->set_float("pointLights[0].constant", point_lights[0]->constant);
            shader->set_float("pointLights[0].linear", point_lights[0]->linear);
            shader->set_float("pointLights[0].quadratic", point_lights[0]->quadratic);
            shader->set_vec3("pointLights[0].ambient", &point_lights[0]->ambient);
            shader->set_vec3("pointLights[0].diffuse", &point_lights[0]->diffuse);
            shader->set_vec3("pointLights[0].specular", &point_lights[0]->specular);
        }
        if point_lights[1] != null {
            num_active_point_lights = num_active_point_lights + 1;
            shader->set_vec3("pointLights[1].position", &point_lights[1]->position);
            shader->set_float("pointLights[1].constant", point_lights[1]->constant);
            shader->set_float("pointLights[1].linear", point_lights[1]->linear);
            shader->set_float("pointLights[1].quadratic", point_lights[1]->quadratic);
            shader->set_vec3("pointLights[1].ambient", &point_lights[1]->ambient);
            shader->set_vec3("pointLights[1].diffuse", &point_lights[1]->diffuse);
            shader->set_vec3("pointLights[1].specular", &point_lights[1]->specular);
        }
        if point_lights[2] != null {
            num_active_point_lights = num_active_point_lights + 1;
            shader->set_vec3("pointLights[2].position", &point_lights[2]->position);
            shader->set_float("pointLights[2].constant", point_lights[2]->constant);
            shader->set_float("pointLights[2].linear", point_lights[2]->linear);
            shader->set_float("pointLights[2].quadratic", point_lights[2]->quadratic);
            shader->set_vec3("pointLights[2].ambient", &point_lights[2]->ambient);
            shader->set_vec3("pointLights[2].diffuse", &point_lights[2]->diffuse);
            shader->set_vec3("pointLights[2].specular", &point_lights[2]->specular);
        }
        if point_lights[3] != null {
            num_active_point_lights = num_active_point_lights + 1;
            shader->set_vec3("pointLights[3].position", &point_lights[3]->position);
            shader->set_float("pointLights[3].constant", point_lights[3]->constant);
            shader->set_float("pointLights[3].linear", point_lights[3]->linear);
            shader->set_float("pointLights[3].quadratic", point_lights[3]->quadratic);
            shader->set_vec3("pointLights[3].ambient", &point_lights[3]->ambient);
            shader->set_vec3("pointLights[3].diffuse", &point_lights[3]->diffuse);
            shader->set_vec3("pointLights[3].specular", &point_lights[3]->specular);
        }
        shader->set_int("numActivePointLights", num_active_point_lights);

        let num_active_spot_lights: int32 = 0;

        if spot_lights[0] != null {
            num_active_spot_lights = num_active_spot_lights + 1;
            shader->set_vec3("spotLights[0].position", &spot_lights[0]->position);
            shader->set_vec3("spotLights[0].direction", &spot_lights[0]->direction);
            shader->set_float("spotLights[0].cutOff", spot_lights[0]->cut_off);
            shader->set_float("spotLights[0].outerCutOff", spot_lights[0]->outer_cut_off);
            shader->set_float("spotLights[0].constant", spot_lights[0]->constant);
            shader->set_float("spotLights[0].linear", spot_lights[0]->linear);
            shader->set_float("spotLights[0].quadratic", spot_lights[0]->quadratic);
            shader->set_vec3("spotLights[0].ambient", &spot_lights[0]->ambient);
            shader->set_vec3("spotLights[0].diffuse", &spot_lights[0]->diffuse);
            shader->set_vec3("spotLights[0].specular", &spot_lights[0]->specular);
        }
        if spot_lights[1] != null {
            num_active_spot_lights = num_active_spot_lights + 1;
            shader->set_vec3("spotLights[1].position", &spot_lights[1]->position);
            shader->set_vec3("spotLights[1].direction", &spot_lights[1]->direction);
            shader->set_float("spotLights[1].cutOff", spot_lights[1]->cut_off);
            shader->set_float("spotLights[1].outerCutOff", spot_lights[1]->outer_cut_off);
            shader->set_float("spotLights[1].constant", spot_lights[1]->constant);
            shader->set_float("spotLights[1].linear", spot_lights[1]->linear);
            shader->set_float("spotLights[1].quadratic", spot_lights[1]->quadratic);
            shader->set_vec3("spotLights[1].ambient", &spot_lights[1]->ambient);
            shader->set_vec3("spotLights[1].diffuse", &spot_lights[1]->diffuse);
            shader->set_vec3("spotLights[1].specular", &spot_lights[1]->specular);
        }

        let i: uint64 = 0;
        while i < model->meshes.len() {
            let mesh = model->meshes.get(i);
            // std::printf("Number of vertices on this mesh: %d\n", mesh->vertices.len());
            let mesh_world = model->matrix * mesh->local_transform;
            shader->set_mat4("model", &mesh_world);
            
            mesh->vertex_array()->bind();
            mesh->index_buffer()->bind();

            if mesh->material.diffuse.has_value() {
                mesh->material.diffuse.get()->set_texture_unit(GL::TEXTURE0);
            } else {
                this->default_diffuse.set_texture_unit(GL::TEXTURE0);
            }
            shader->set_int("material.diffuse", 0);

            if mesh->material.specular.has_value() {
                mesh->material.specular.get()->set_texture_unit(GL::TEXTURE1);
            } else {
                this->default_specular.set_texture_unit(GL::TEXTURE1);
            }
            shader->set_int("material.specular", 1);

            if mesh->material.normal_map.has_value() {
                mesh->material.normal_map.get()->set_texture_unit(GL::TEXTURE2);
            } else {
                this->default_normal_map.set_texture_unit(GL::TEXTURE2);
            }
            shader->set_int("material.normal_map", 2);

            if mesh->material.emission.has_value() {
                mesh->material.emission.get()->set_texture_unit(GL::TEXTURE3);
            } else {
                this->default_emission.set_texture_unit(GL::TEXTURE3);
            }
            shader->set_int("material.emission", 3);

            glActiveTexture(GL::TEXTURE0);

            shader->set_float("material.shininess", mesh->material.shininess);
            glDrawElements(GL::TRIANGLES, mesh->index_buffer()->get_count(), GL::UNSIGNED_INT, null);
            i = i + 1;
        }
    }
}