import "src/utils/model.atlas";

public struct Renderer {
  public:
    default_diffuse: Texture2D;
    default_specular: Texture2D;
    default_normal_map: Texture2D;
    default_emission: Texture2D;
    fun default() -> This { 
        return Renderer {
            .default_diffuse    = Texture2D::from_color(
                255, 255, 255, 255, std::string::from_chars("material.diffuse")),
            .default_specular   = Texture2D::from_color(
                  0,   0,   0, 255, std::string::from_chars("material.specular")),
            .default_normal_map = Texture2D::from_color(
                128, 128, 255, 255, std::string::from_chars("material.normal_map")),
            .default_emission = Texture2D::from_color(
                  0,   0,   0, 255, std::string::from_chars("material.emission"))
        }; 
    }

    fun clear_color(*const this, r: float32, g: float32, b: float32, a: float32) { glClearColor(r, g, b, a); }
    fun clear(*const this) { glClear(GL::COLOR_BUFFER_BIT | GL::DEPTH_BUFFER_BIT); }

    fun begin_scene(*const this, shader: *const ShaderProgram, view: *const la::mat4, projection: *const la::mat4) {
        shader->bind();
        shader->set_mat4("view", view);
        shader->set_mat4("projection", projection);
    }

    fun submit(
        *const this,
        va: *const VertexArray,
        ib: *const IndexBuffer,
        shader: *const ShaderProgram,
        model: *const la::mat4
    ) {
        shader->set_mat4("model", model);
        va->bind();
        ib->bind();
        glDrawElements(GL::TRIANGLES, ib->get_count(), GL::UNSIGNED_INT, null);
    }

    // Non-indexed single-mesh draw. Requires begin_scene() called first
    // (shader bound, view/projection set).
    fun submit_mesh(
        *const this,
        va: *const VertexArray,
        shader: *const ShaderProgram,
        model: *const la::mat4,
        vertex_count: int32
    ) {
        shader->set_mat4("model", model);
        va->bind();
        glDrawArrays(GL::TRIANGLES, 0, vertex_count);
    }

    fun draw_model(
        *const this,
        model: *const Model,
        shader: *const ShaderProgram,
        view: *const la::mat4,
        projection: *const la::mat4
    ) {
        shader->bind();
        shader->set_mat4("view", view);
        shader->set_mat4("projection", projection);

        let i: uint64 = 0;
        while i < model->meshes.len() {
            let mesh = model->meshes.get(i);
            // std::printf("Number of vertices on this mesh: %d\n", mesh->vertices.len());
            let mesh_world = model->matrix * mesh->local_transform;
            shader->set_mat4("model", &mesh_world);
            
            mesh->vertex_array()->bind();
            mesh->index_buffer()->bind();

            if mesh->material.diffuse.has_value() {
                mesh->material.diffuse.get()->set_texture_unit(GL::TEXTURE0);
            } else {
                this->default_diffuse.set_texture_unit(GL::TEXTURE0);
            }
            shader->set_int("material.diffuse", 0);

            if mesh->material.specular.has_value() {
                mesh->material.specular.get()->set_texture_unit(GL::TEXTURE1);
            } else {
                this->default_specular.set_texture_unit(GL::TEXTURE1);
            }
            shader->set_int("material.specular", 1);

            if mesh->material.normal_map.has_value() {
                mesh->material.normal_map.get()->set_texture_unit(GL::TEXTURE2);
            } else {
                this->default_normal_map.set_texture_unit(GL::TEXTURE2);
            }
            shader->set_int("material.normal_map", 2);

            if mesh->material.emission.has_value() {
                mesh->material.emission.get()->set_texture_unit(GL::TEXTURE3);
            } else {
                this->default_emission.set_texture_unit(GL::TEXTURE3);
            }
            shader->set_int("material.emission", 3);

            glActiveTexture(GL::TEXTURE0);

            shader->set_float("material.shininess", mesh->material.shininess);
            glDrawElements(GL::TRIANGLES, mesh->index_buffer()->get_count(), GL::UNSIGNED_INT, null);
            i = i + 1;
        }
    }

    fun draw(
        *const this,
        va: *const VertexArray,
        shader: *const ShaderProgram,
        positions: *const std::vector<la::vec3>,
        view: *const la::mat4,
        projection: *const la::mat4,
    ) {
        shader->bind();
        va->bind();

        let i: uint64 = 0;
        while i < positions->len() {
            let pos = positions->get(i);
            let angle = 20.0 * i as float32;
            let model_matrix = la::mat4::identity()
                .translated(pos->x(), pos->y(), pos->z())
                .rotated(&la::vec3::new(0.0, 0.0, -3.0), la::radians(angle));

            shader->set_mat4("model", &model_matrix);
            shader->set_mat4("view", view);
            shader->set_mat4("projection", projection);

            glDrawArrays(GL::TRIANGLES, 0, 36);
            i = i + 1;
        }
    }
}