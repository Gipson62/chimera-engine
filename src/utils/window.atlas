import "src/glfw3.atlas";
import "src/glad.atlas";

// I'll probably use OpenGL 4.6 ngl
public struct Window {
  public:

    fun default() -> std::expected<This, std::string> {
        return Window::new(800, 600, "Chimera Engine", Window::default_callback);
    }
    fun new(width: int32, height: int32, title: str, callback: fun(*glfw::window, int32, int32) -> unit) -> std::expected<This, std::string> {
        glfw::Init();
        glfw::WindowHint(glfw::CONTEXT_VERSION_MAJOR(), 3);
        glfw::WindowHint(glfw::CONTEXT_VERSION_MINOR(), 3);
        glfw::WindowHint(glfw::OPENGL_PROFILE(), glfw::OPENGL_CORE_PROFILE());

        let w = Window {
            .width = width,
            .height = height,
            .title = title,
            .handle = null,
            .callback = callback,
        };
        w.handle = glfw::CreateWindow(w.width, w.height, w.title, null, null);

        if w.handle == null {
            return std::expected<This, std::string>::unexpected(std::string::from_chars("Failed to create GLFW window"));
        }

        glfw::MakeContextCurrent(w.handle);

        glfw::SetFramebufferSizeCallback(w.handle, w.callback);

        if (gladLoadGLLoader(glfw::GetProcAddress as fun(*const char) -> *unit) == 0) {
            return std::expected<This, std::string>::unexpected(std::string::from_chars("Failed to initialize GLAD"));
        }

        glViewport(0, 0, width, height);

        return std::expected<This, std::string>::expect(std::move(w));
    }
    fun swap_buffers(*this) {
        glfw::SwapBuffers(this->handle);
    }
    fun default_callback(handle: *glfw::window, width: int32, height: int32) -> unit {
        glViewport(0, 0, width, height);
    }
    fun process_inputs(*this) {
        if glfw::GetKey(this->handle, glfw::KEY::ESCAPE) == glfw::KeyState::Press {
            glfw::SetWindowShouldClose(this->handle, true);
        }
    }
    fun set_window_title(*this, new_title: *uint8) {
        glfw::SetWindowTitle(this->handle, new_title);
    }
    fun should_close(*const this) -> bool {
        return glfw::WindowShouldClose(this->handle) == 0;
    }
    fun poll_events(*const this) {
        glfw::PollEvents();
    }

    ~Window() {
        glfw::Terminate();
    }

  private:
    width: int32;
    height: int32;
    title: str;
    handle: *glfw::window;
    callback: fun(*glfw::window, int32, int32) -> unit;
    // TODO: Add monitor and share
}