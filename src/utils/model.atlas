import "src/utils/material.atlas";
import "src/utils/mesh.atlas";

import "src/assimp.atlas";
import "src/linear_algebra.atlas";

public struct MissingTexture {
  public:
    mesh_index: uint64;
    slot: TEXTURE_TYPE;
}

public struct Model {
  public:
    meshes: std::vector<Mesh>;
    path: std::string;
    directory: std::string;
    // TODO move that to the Model Instance later on
    matrix: la::mat4;

    fun load_model(path: std::string) -> std::optional<This> {
        std::printf("Start of model loading %f\n", glfw::GetTime() as float32);

        let scene: *const assimp::Scene = assimp::ImportFile(path.c_str(),
            assimp::PostProcessSteps::Triangulate as uint32 |
            assimp::PostProcessSteps::FlipUVs as uint32 |
            assimp::PostProcessSteps::CalcTangentSpace as uint32);

        if scene == null {
            std::printf("assimp import failed for %s: ", path.c_str());
            std::printf("%s\n", assimp::GetErrorString());
            return std::optional<This>::empty();
        }
        if (scene->mFlags & assimp::SceneFlag::INCOMPLETE as uint32) != 0 {
            std::printf("assimp import incomplete for %s: ", path.c_str());
            std::printf("%s\n", assimp::GetErrorString());
            return std::optional<This>::empty();
        }

        let directory = Model::directory_of(&path);

        let meshes = std::vector<Mesh>::with_capacity(0);
        Model::process_node(
            scene->mRootNode,
            scene,
            &directory,
            la::mat4::identity(),
            &meshes
        );

        let model = Model {
            .meshes = std::move(meshes),
            .path = std::move(path),
            .directory = std::move(directory),
            .matrix = la::mat4::identity(),
        };

        assimp::ReleaseImport(scene);
        std::printf("End of model loading %f\n", glfw::GetTime() as float32);

        return std::optional<This>::of(std::move(model));
    }

    fun process_node(
        node: *assimp::Node,
        scene: *const assimp::Scene,
        directory: *const std::string,
        parent_transform: la::mat4,
        out_meshes: *std::vector<Mesh>
    ) {
        let node_transform = parent_transform * Model::mat4_from_assimp(&node->mTransformation);

        let i: uint64 = 0;
        while i < node->mNumMeshes as uint64 {
            let mesh = scene->mMeshes[node->mMeshes[i]];
            let processed_mesh = Model::process_mesh(
                mesh,
                scene,
                directory,
                node_transform
            );
            out_meshes->push(std::move(processed_mesh));
            i = i + 1;
        }

        let i_children: uint64 = 0;
        while i_children < node->mNumChildren as uint64 {
            Model::process_node(
                node->mChildren[i_children],
                scene,
                directory,
                node_transform,
                out_meshes
            );
            i_children = i_children + 1;
        }
    }

    fun process_mesh(
        mesh: *assimp::Mesh,
        scene: *const assimp::Scene,
        directory: *const std::string,
        local_transform: la::mat4
    ) -> Mesh {
        let vertices = std::vector<Vertex>::with_capacity(mesh->mNumVertices);
        let indices = std::vector<uint32>::with_capacity(mesh->mNumFaces * 3);

        let i: uint64 = 0;
        while i < mesh->mNumVertices as uint64 {
            let pos = mesh->mVertices[i];
            let vertex = Vertex {
                .position   = la::vec3::new(pos.x, pos.y, pos.z),
                .normal     = la::vec3::zero(),
                .tex_coords = la::vec2::zero(),
                .tangent    = la::vec3::zero(),
                .bitangent  = la::vec3::zero(),
            };

            if mesh->mNormals != null {
                let n = mesh->mNormals[i];
                vertex.normal = la::vec3::new(n.x, n.y, n.z);
            }
            if mesh->mTangents != null {
                let t = mesh->mTangents[i];
                vertex.tangent = la::vec3::new(t.x, t.y, t.z);
            }
            if mesh->mBitangents != null {
                let b = mesh->mBitangents[i];
                vertex.bitangent = la::vec3::new(b.x, b.y, b.z);
            }
            if mesh->mTextureCoords[0] != null {
                let uv = mesh->mTextureCoords[0][i];
                vertex.tex_coords = la::vec2::new(uv.x, uv.y);
            }

            vertices.push(vertex);
            i = i + 1;
        }

        let f: uint64 = 0;
        while f < mesh->mNumFaces as uint64 {
            let face = mesh->mFaces[f];
            let idx: uint64 = 0;
            while idx < face.mNumIndices as uint64 {
                indices.push(face.mIndices[idx]);
                idx = idx + 1;
            }
            f = f + 1;
        }

        let ai_mat = scene->mMaterials[mesh->mMaterialIndex];

        let diffuse  = Model::load_material_texture(
            ai_mat, 
            assimp::TextureType::DIFFUSE,
            directory,
            TEXTURE_TYPE::MATERIAL_DIFFUSE
        );
        let specular = Model::load_material_texture(
            ai_mat,
            assimp::TextureType::SPECULAR,
            directory,
            TEXTURE_TYPE::MATERIAL_SPECULAR
        );
        let emission = Model::load_material_texture(
            ai_mat,
            assimp::TextureType::EMISSIVE,
            directory,
            TEXTURE_TYPE::MATERIAL_EMISSION
        );

        let normal_map = Model::load_material_texture(
            ai_mat,
            assimp::TextureType::NORMALS,
            directory,
            TEXTURE_TYPE::MATERIAL_NORMAL
        );
        if normal_map.is_empty() {
            normal_map = Model::load_material_texture(
                ai_mat,
                assimp::TextureType::HEIGHT,
                directory,
                TEXTURE_TYPE::MATERIAL_NORMAL
            );
        }

        let shininess: float32 = 32.0;
        let shininess_out: float32 = 0.0;
        let written: uint32 = 0;
        if assimp::GetMaterialFloatArray(ai_mat, assimp::KEY_SHININESS(), 0, 0, &shininess_out, &written) == assimp::Return::SUCCESS {
            shininess = shininess_out;
        }

        let material = Material::new(
            "material",
            std::move(diffuse),
            std::move(specular),
            std::move(emission),
            std::move(normal_map),
            shininess
        );
        return Mesh::new(std::move(vertices), std::move(indices), std::move(material), local_transform);
    }

    fun load_material_texture(
        mat: *assimp::Material,
        ai_type: uint32,
        directory: *const std::string,
        type: TEXTURE_TYPE
    ) -> std::optional<Texture2D> {
        if assimp::GetMaterialTextureCount(mat, ai_type) == 0 {
            return std::optional<Texture2D>::empty();
        }

        let path_out = assimp::String { .length = 0, .data = [0] };
        let result = assimp::GetMaterialTexture(mat, ai_type, 0, &path_out, null, null, null, null, null, null);
        if result != assimp::Return::SUCCESS {
            std::printf("[Model] GetMaterialTexture failed: %s\n", assimp::GetErrorString());
            return std::optional<Texture2D>::empty();
        }

        let full_path = directory->copy();
        full_path.push_str("/");
        full_path.push_str(&path_out.data[0]);

        return Texture2D::new(std::move(full_path), type);
    }

    // Finds the last occurrence of any byte in `chars` (a null-terminated
    // set, e.g. "/\\" or ".") within `s`. Shared by directory_of and
    // anything else that needs to split a path on separators/extension.
    fun find_last_of(s: *const std::string, chars: *const uint8) -> std::optional<uint64> {
        let bytes = s->c_str();
        let len = s->len();

        let num_chars: uint64 = 0;
        while chars[num_chars] != 0 { num_chars = num_chars + 1; }

        let i: uint64 = len;
        while i > 0 {
            i = i - 1;
            let c: uint64 = 0;
            while c < num_chars {
                if bytes[i] == chars[c] {
                    return std::optional<uint64>::of(i);
                }
                c = c + 1;
            }
        }
        return std::optional<uint64>::empty();
    }

    fun directory_of(path: *const std::string) -> std::string {
        let slash = Model::find_last_of(path, "/\\");
        if slash.is_empty() { return std::string::from_chars("."); }
        return path->substr(0, slash.value());
    }

    fun mat4_from_assimp(m: *const assimp::Matrix4x4) -> la::mat4 {
        return la::mat4::from_row_major(
            m->a1, m->a2, m->a3, m->a4,
            m->b1, m->b2, m->b3, m->b4,
            m->c1, m->c2, m->c3, m->c4,
            m->d1, m->d2, m->d3, m->d4
        );
    }

    fun missing_textures(*const this) -> std::vector<MissingTexture> {
        let out = std::vector<MissingTexture>::with_capacity(0);
        let i: uint64 = 0;
        while i < this->meshes.len() {
            let mesh = this->meshes.get(i);
            if mesh->material.diffuse.is_empty()    { out.push(MissingTexture { .mesh_index = i, .slot = TEXTURE_TYPE::MATERIAL_DIFFUSE }); }
            if mesh->material.specular.is_empty()   { out.push(MissingTexture { .mesh_index = i, .slot = TEXTURE_TYPE::MATERIAL_SPECULAR }); }
            if mesh->material.emission.is_empty()   { out.push(MissingTexture { .mesh_index = i, .slot = TEXTURE_TYPE::MATERIAL_EMISSION }); }
            if mesh->material.normal_map.is_empty() { out.push(MissingTexture { .mesh_index = i, .slot = TEXTURE_TYPE::MATERIAL_NORMAL }); }
            i = i + 1;
        }
        return std::move(out);
    }

    fun set_texture(*this, mesh_index: uint64, slot: TEXTURE_TYPE, texture: std::optional<Texture2D>) {
        let mesh = this->meshes.get_mut(mesh_index);

        if      slot == TEXTURE_TYPE::MATERIAL_DIFFUSE    { mesh->material.diffuse    = std::move(texture); }
        else if slot == TEXTURE_TYPE::MATERIAL_SPECULAR   { mesh->material.specular   = std::move(texture); }
        else if slot == TEXTURE_TYPE::MATERIAL_EMISSION   { mesh->material.emission   = std::move(texture); }
        else if slot == TEXTURE_TYPE::MATERIAL_NORMAL     { mesh->material.normal_map = std::move(texture); }
    }
}