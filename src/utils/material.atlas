import "std/vector";

import "src/utils/texture.atlas";

public struct Material {
  public:
    name: str;
    diffuse: std::optional<Texture2D>;
    specular: std::optional<Texture2D>;
    normal_map: std::optional<Texture2D>;
    shininess: float32;

    fun new(
        name: str,
        diffuse: std::optional<Texture2D>,
        specular: std::optional<Texture2D>,
        normal_map: std::optional<Texture2D>,
        shininess: float32
    ) -> This {
        return Material {
            .name      = name,
            .diffuse   = std::move(diffuse),
            .specular  = std::move(specular),
            .normal_map = std::move(normal_map),
            .shininess = shininess,
        };
    }
}