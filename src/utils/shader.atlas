import "std/file";

import "src/glad.atlas";

import "std/optional";

enum ShaderKind {
    FRAGMENT_SHADER = 0x8B30;
    VERTEX_SHADER   = 0x8B31;
}

public  struct ShaderStage {
  public:
    //TODO: Potentially use std::expected<This, ShaderError>
    // With ShaderError possibly being "File not found" or "Compilation Failed"
    fun new(path: str, kind: ShaderKind) -> std::optional<This> {
        let file = std::file::read_to_string(path);
        if file.is_unexpected() {
            return std::optional<This>::empty();
        }

        let shader_source: *const uint8 = file.expected_value().c_str();
        let id = glCreateShader(kind);

        glShaderSource(id, 1, &shader_source as const *const str, null);
        glCompileShader(id);

        let success: int32 = 1;
        glGetShaderiv(id, GL::COMPILE_STATUS, &success);
        if success == 0 {
            let infoLog: [uint8; 256] = [0; 256];
            glGetShaderInfoLog(id, 256, null, &infoLog[0]);
            std::printf("SHADER COMPILATION ERROR: %s", infoLog);

            glDeleteShader(id);
            return std::optional<This>::empty();
        }

        return std::optional<This>::of(ShaderStage { .id = id });
    }
    ~ShaderStage() {
        glDeleteShader(this->id);
    }
    fun get_id(*const this) -> uint32 {
        return this->id;
    }

  private:
    id: uint32;
}

public struct ShaderProgram {
  public:
    fun link(vertex: ShaderStage, fragment: ShaderStage) -> std::optional<This> {
        let id = glCreateProgram();
        glAttachShader(id, vertex.get_id());
        glAttachShader(id, fragment.get_id());
        glLinkProgram(id);

        let success: int32 = 0;
        glGetProgramiv(id, GL::LINK_STATUS, &success);
        if success == 0 {
            let infoLog: [uint8; 256] = [0; 256];
            glGetProgramInfoLog(id, 256, null, &infoLog[0]);
            std::printf("SHADER PROGRAM LINKING ERROR: %s", infoLog);

            glDeleteProgram(id);
            return std::optional<This>::empty();
        }

        return std::optional<This>::of(ShaderProgram { .id = id });
    }
    // Todo: maintain a custom cheap `std::map<str, uint32>`
    fun set_int(*const this, name: str, value: int32) {
        glUniform1i(glGetUniformLocation(this->id, name), value);
    }
    fun set_uint(*const this, name: str, value: uint32) {
        glUniform1ui(glGetUniformLocation(this->id, name), value);
    }
    fun set_bool(*const this, name: str, value: bool) {
        glUniform1i(glGetUniformLocation(this->id, name), value as int32);
    }
    fun set_float(*const this, name: str, value: float32) {
        glUniform1f(glGetUniformLocation(this->id, name), value);
    }
    fun set_mat4(*const this, name: str, value: *const la::mat4) {
        glUniformMatrix4fv(glGetUniformLocation(this->id, name), 1, GL::FALSE, value->get_ptr());
    }
    fun set_vec2(*const this, name: str, value: *const la::vec2) {
        glUniform2f(glGetUniformLocation(this->id, name), value->x(), value->y());
    }
    fun set_vec3(*const this, name: str, value: *const la::vec3) {
        glUniform3f(glGetUniformLocation(this->id, name), value->x(), value->y(), value->z());
    }
    fun set_vec4(*const this, name: str, value: *const la::vec4) {
        glUniform4f(glGetUniformLocation(this->id, name), value->x(), value->y(), value->z(), value->w());
    }
    fun set_uvec2(*const this, name: str, x: uint32, y: uint32) {
        glUniform2ui(glGetUniformLocation(this->id, name), x, y);
    }
    fun set_uvec3(*const this, name: str, x: uint32, y: uint32, z: uint32) {
        glUniform3ui(glGetUniformLocation(this->id, name), x, y, z);
    }
    fun set_uvec4(*const this, name: str, x: uint32, y: uint32, z: uint32, w: uint32) {
        glUniform4ui(glGetUniformLocation(this->id, name), x, y, z, w);
    }
    fun bind(*const this) {
        glUseProgram(this->id);
    }

    ~ShaderProgram() {
        glDeleteProgram(this->id);
    }

  private:
    id: uint32;
}