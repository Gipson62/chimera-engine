import "std/io";
import "std/memory";
import "std/time";
import "std/file";

import "src/glfw3.atlas";
import "src/glad.atlas";
import "src/linear_algebra.atlas";

import "src/utils/buffer.atlas";
import "src/utils/shader.atlas";
import "src/utils/renderer.atlas";
import "src/utils/window.atlas";
import "src/utils/camera.atlas";
import "src/utils/input.atlas";
import "src/utils/application.atlas";
import "src/utils/texture.atlas";
import "src/utils/mesh.atlas";
import "src/utils/shape.atlas";
import "src/utils/model.atlas";

extern "C" fun sprintf<T>(buffer: *uint8, format: const str, val: T) -> int32;

fun main() -> int32 {
    let app_res = Application::new();
    if app_res.is_unexpected() { std::panic("Something is wrong with the app boss"); }
    let app = app_res.expected_value();
    app.setup();

    // --- object shader: objectColor * lightColor ---
    let vertex_shader_opt = ShaderStage::new("src/vertex.vert", ShaderKind::VERTEX_SHADER);
    if vertex_shader_opt.is_empty() { std::panic("Something is wrong with the vertex shader boss"); }
    let fragment_shader_opt = ShaderStage::new("src/fragment.frag", ShaderKind::FRAGMENT_SHADER);
    if fragment_shader_opt.is_empty() { std::panic("Something is wrong with the fragment shader boss"); }

    let shader_program_opt = ShaderProgram::link(
        vertex_shader_opt.value(),
        fragment_shader_opt.value()
    );
    if shader_program_opt.is_empty() { std::panic("Something is wrong with the shader program boss"); }
    let shader_program = shader_program_opt.value();

    // --- light shader: flat white ---
    let light_vertex_shader_opt = ShaderStage::new("src/vertex.vert", ShaderKind::VERTEX_SHADER);
    if light_vertex_shader_opt.is_empty() { std::panic("Something is wrong with the light vertex shader boss"); }
    let light_fragment_shader_opt = ShaderStage::new("src/light.frag", ShaderKind::FRAGMENT_SHADER);
    if light_fragment_shader_opt.is_empty() { std::panic("Something is wrong with the light fragment shader boss"); }

    let light_shader_program_opt = ShaderProgram::link(
        light_vertex_shader_opt.value(),
        light_fragment_shader_opt.value()
    );
    if light_shader_program_opt.is_empty() { std::panic("Something is wrong with the light shader program boss"); }
    let light_shader_program = light_shader_program_opt.value();
    
    // --- Initializing the Model ---
    let cube_model = create_debug_cube("src/container2.png", "src/container2_specular.png");

    shader_program.bind();
    shader_program.set_vec3("light.ambient", &la::vec3::new(0.2, 0.2, 0.2));
    shader_program.set_vec3("light.diffuse", &la::vec3::new(0.5, 0.5, 0.5));
    shader_program.set_vec3("light.specular", &la::vec3::new(1.0, 1.0, 1.0));
    shader_program.set_float("light.constant", 1.0);
    shader_program.set_float("light.linear", 0.09);
    shader_program.set_float("light.quadratic", 0.032);

    let light_pos = la::vec3::new(1.2, 1.0, 2.0);

    let fps_timer = std::instant::now();
    let frame_count: int64 = 0;

    let cube_positions = std::vector<la::vec3>::with_capacity(10);
        cube_positions.push(la::vec3::new( 0.0,  0.0,  0.0));
        cube_positions.push(la::vec3::new( 2.0,  5.0, -15.0));
        cube_positions.push(la::vec3::new(-1.5, -2.2, -2.5));
        cube_positions.push(la::vec3::new(-3.8, -2.2, -12.3));
        cube_positions.push(la::vec3::new( 2.4, -0.4, -3.5));
        cube_positions.push(la::vec3::new(-1.7,  3.0, -7.5));
        cube_positions.push(la::vec3::new( 1.3, -2.0, -2.5));
        cube_positions.push(la::vec3::new( 1.5,  2.0, -2.5));
        cube_positions.push(la::vec3::new( 1.5,  0.2, -1.5));
        cube_positions.push(la::vec3::new(-1.3,  1.0, -1.5));

    while (!app.should_close()) {
        let delta_time = app.begin_frame();
        let renderer = app.renderer();

        app.process_input(delta_time);

        renderer->clear_color(0.2, 0.3, 0.3, 1.0);
        renderer->clear();

        let view = app.camera()->view_matrix();
        let projection = app.camera()->projection_matrix();

        light_pos.set(0, 1.0 + la::sin(glfw::GetTime() as float32) * 2.0);
        light_pos.set(1, la::sin(glfw::GetTime() as float32 / 2.0) * 1.0);

        shader_program.bind();
        shader_program.set_vec3("viewPos", &app.camera()->position());
        shader_program.set_vec3("light.position", &app.camera()->position());
        shader_program.set_vec3("light.direction", &app.camera()->front());
        shader_program.set_float("light.cutOff", la::cos(la::radians(12.5)));
        shader_program.set_float("light.outerCutOff", la::cos(la::radians(17.5)));
        
        let i: uint64 = 0;
        while i < cube_positions.len() {
            let pos = cube_positions.get(i);
            let angle = 20.0 * i as float32;
            
            cube_model.matrix = la::mat4::identity()
                .translated(pos->x(), pos->y(), pos->z())
                .rotated(&la::vec3::new(1.0, 0.3, 0.5), la::radians(angle));

            renderer->draw_model(&cube_model, &shader_program, &view, &projection);
            i = i + 1;
        }

  

        // Draw light source using the geometry of the first mesh inside cube_model
        let light_model = la::mat4::identity()
            .translated(light_pos.x(), light_pos.y(), light_pos.z())
            .scaled(0.2, 0.2, 0.2);

        renderer->begin_scene(&light_shader_program, &view, &projection);
        
        let light_mesh = cube_model.meshes.get(0);
        light_shader_program.set_mat4("model", &light_model);
        
        light_mesh->vertex_array()->bind();
        light_mesh->index_buffer()->bind();
        glDrawElements(GL::TRIANGLES, light_mesh->index_buffer()->get_count(), GL::UNSIGNED_INT, null);

        frame_count = frame_count + 1;
        let elapsed = fps_timer.elapsed();

        if (elapsed.ns >= 1_000_000_000) {
            let fps = frame_count as float64 / elapsed.seconds();
            let title: [uint8; 64] = [0; 64];
            sprintf(&title[0], "Atlas77 - FPS: %.1f", fps);
            app.set_window_title(&title[0]);
            frame_count = 0;
            fps_timer = std::instant::now();
        }

        app.end_frame();
    }

    return 0;
}