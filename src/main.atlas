import "std/io";
import "std/memory";
import "std/time";
import "std/file";

import "src/glfw3.atlas";
import "src/glad.atlas";
import "src/linear_algebra.atlas";

import "src/utils/buffer.atlas";
import "src/utils/shader.atlas";
import "src/utils/renderer.atlas";
import "src/utils/window.atlas";
import "src/utils/camera.atlas";
import "src/utils/input.atlas";
import "src/utils/application.atlas";
import "src/utils/texture.atlas";
import "src/utils/mesh.atlas";
import "src/utils/shape.atlas";
import "src/utils/model.atlas";
import "src/utils/light/directional_light.atlas";
import "src/utils/light/point_light.atlas";
import "src/utils/light/spotlight.atlas";

extern "C" fun sprintf<T>(buffer: *uint8, format: const str, val: T) -> int32;

fun main() -> int32 {
    let app_res = Application::new();
    if app_res.is_unexpected() { std::panic("Something is wrong with the app boss"); }
    let app = app_res.expected_value();
    app.setup();

    // --- object shader: objectColor * lightColor ---
    let vertex_shader_opt = ShaderStage::new("src/shader/vertex.vert", ShaderKind::VERTEX_SHADER);
    if vertex_shader_opt.is_empty() { std::panic("Something is wrong with the vertex shader boss"); }
    let fragment_shader_opt = ShaderStage::new("src/shader/fragment.frag", ShaderKind::FRAGMENT_SHADER);
    if fragment_shader_opt.is_empty() { std::panic("Something is wrong with the fragment shader boss"); }

    let shader_program_opt = ShaderProgram::link(
        vertex_shader_opt.value(),
        fragment_shader_opt.value()
    );
    if shader_program_opt.is_empty() { std::panic("Something is wrong with the shader program boss"); }
    let shader_program = shader_program_opt.value();

    // --- light shader: flat white ---
    let light_vertex_shader_opt = ShaderStage::new("src/shader/vertex.vert", ShaderKind::VERTEX_SHADER);
    if light_vertex_shader_opt.is_empty() { std::panic("Something is wrong with the light vertex shader boss"); }
    let light_fragment_shader_opt = ShaderStage::new("src/shader/light.frag", ShaderKind::FRAGMENT_SHADER);
    if light_fragment_shader_opt.is_empty() { std::panic("Something is wrong with the light fragment shader boss"); }

    let light_shader_program_opt = ShaderProgram::link(
        light_vertex_shader_opt.value(),
        light_fragment_shader_opt.value()
    );
    if light_shader_program_opt.is_empty() { std::panic("Something is wrong with the light shader program boss"); }
    let light_shader_program = light_shader_program_opt.value();
    
    // --- Initializing the Model ---
    let model_3d = Model::load_model(std::string::from_chars("assets/models/vampire/dancing_vampire.dae")).value();

    //model_3d.matrix = la::mat4::identity().scaled(1.0, 1.0, 1.0);

    shader_program.bind();

    let fps_timer = std::instant::now();
    let frame_count: int64 = 0;

    let model_positions = std::vector<la::vec3>::with_capacity(10);
        model_positions.push(la::vec3::new( 0.0,  0.0,   0.0));
        model_positions.push(la::vec3::new( 2.0,  5.0, -15.0));
        model_positions.push(la::vec3::new(-1.5, -2.2,  -2.5));
        model_positions.push(la::vec3::new(-3.8, -2.2, -12.3));
        model_positions.push(la::vec3::new( 2.4, -0.4,  -3.5));
        model_positions.push(la::vec3::new(-1.7,  3.0,  -7.5));
        model_positions.push(la::vec3::new( 1.3, -2.0,  -2.5));
        model_positions.push(la::vec3::new( 1.5,  2.0,  -2.5));
        model_positions.push(la::vec3::new( 1.5,  0.2,  -1.5));
        model_positions.push(la::vec3::new(-1.3,  1.0,  -1.5));

    // We don't need textures for this cube
    let cube = create_debug_cube("", "", "", "");

    let dir_light = DirectionalLight::new(
        la::vec3::new(-0.2, -1.0, -0.3),
        la::vec3::new(0.2, 0.2, 0.2),
        la::vec3::new(0.5, 0.5, 0.5),
        la::vec3::new(1.0, 1.0, 1.0)
    );
    let point_light = PointLight::new(
        la::vec3::new(1.2, 1.0, 2.0),
        1.0,
        0.09,
        0.032,
        la::vec3::new(0.2, 0.2, 0.2),
        la::vec3::new(0.5, 0.5, 0.5),
        la::vec3::new(1.0, 1.0, 1.0)
    );

    while (!app.should_close()) {
        let delta_time = app.begin_frame();
        let renderer = app.renderer();

        app.process_input(delta_time);

        renderer->clear_color(0.2, 0.3, 0.3, 1.0);
        renderer->clear();

        let view = app.camera()->view_matrix();
        let projection = app.camera()->projection_matrix();

        point_light.position.set(0, 1.0 + la::sin(glfw::GetTime() as float32) * 2.0);
        point_light.position.set(1, la::sin(glfw::GetTime() as float32 / 2.0) * 1.0);

        shader_program.bind();
        shader_program.set_vec3("viewPos", &app.camera()->position());
        shader_program.set_vec3("light.position", &point_light.position);
        shader_program.set_vec3("lightPos", &point_light.position);
        
        let point_lights = [&point_light, null, null, null];
        let spot_lights: [*SpotLight; 2] = [null, null];

        let i: uint64 = 0;
        while i < model_positions.len() {
            let pos = model_positions.get(i);
            let angle = 20.0 * i as float32 * la::sin(glfw::GetTime() as float32);
            
            model_3d.matrix = la::mat4::identity()
                .translated(pos->x(), pos->y(), pos->z())
                .rotated(&la::vec3::new(1.0, 0.3, 0.5), la::radians(angle));

            renderer->draw_model(
                &model_3d, 
                &shader_program, 
                &view, 
                &projection,
                &dir_light,
                point_lights,
                spot_lights
            );
            i = i + 1;
        }

        // Draw light source using a cube
        cube.matrix = la::mat4::identity()
            .translated(point_light.position.x(), point_light.position.y(), point_light.position.z())
            .scaled(0.2, 0.2, 0.2);

        renderer->draw_model(
            &cube, 
            &light_shader_program, 
            &view, 
            &projection,
            &dir_light,
            point_lights,
            spot_lights
        );

        frame_count = frame_count + 1;
        let elapsed = fps_timer.elapsed();

        if (elapsed.ns >= 1_000_000_000) {
            let fps = frame_count as float64 / elapsed.seconds();
            let title: [uint8; 64] = [0; 64];
            sprintf(&title[0], "Atlas77 - FPS: %.1f", fps);
            app.set_window_title(&title[0]);
            frame_count = 0;
            fps_timer = std::instant::now();
        }

        app.end_frame();
    }

    return 0;
}