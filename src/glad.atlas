public extern fun glCullFace(mode: uint32);
public extern fun glFrontFace(mode: uint32);
public extern fun glHint(target: uint32, mode: uint32);
public extern fun glLineWidth(width: float32);
public extern fun glPointSize(size: float32);
public extern fun glPolygonMode(face: uint32, mode: uint32);
public extern fun glScissor(x: int32, y: int32, width: int32, height: int32);
public extern fun glTexParameterf(target: uint32, pname: uint32, param: float32);
public extern fun glTexParameterfv(target: uint32, pname: uint32, params: *float32);
public extern fun glTexParameteri(target: uint32, pname: uint32, param: int32);
public extern fun glTexParameteriv(target: uint32, pname: uint32, params: *int32);
public extern fun glTexImage1D(target: uint32, level: int32, internalformat: int32, width: int32, border: int32, format: uint32, type: uint32, pixels: *unit);
public extern fun glTexImage2D(target: uint32, level: int32, internalformat: int32, width: int32, height: int32, border: int32, format: uint32, type: uint32, pixels: *unit);
public extern fun glDrawBuffer(buf: uint32);
public extern fun glClear(mask: uint32);
